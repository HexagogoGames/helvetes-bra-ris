[Unit]
Description=Kör wallpaper-cycle.service varje heltimme

[Timer]
# Klockstyrt (inte relativt senaste körning) - byter varje heltimme: 00, 01,
# 02 osv, oavsett när sessionen startade.
OnCalendar=hourly
# Ingen Persistent=true - ett missat byte (t.ex. efter suspend över en
# heltimme) ska inte trigga ett abrupt bakgrundsbyte direkt vid uppvaknande,
# bara vänta till nästa heltimme.

[Install]
WantedBy=timers.target
