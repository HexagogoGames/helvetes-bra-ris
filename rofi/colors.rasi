* {
    /* Base — mörkgrön skog (från forrest-background1) */
    bg:              #17211ae8;
    bg-solid:        #17211aff;
    bg-alt:          #2c3a2ee8;
    bg-hover:        #3a4a3de0;

    /* Text */
    fg:              #ece3c6;
    fg-muted:        #93a08c;

    /* Main accents */
    gold:            #d4a24a;
    gold-soft:       #b8863a;

    leaf:            #7fa66b;
    leaf-soft:       #5c8a4c;

    purple:          #a97ca0;

    /* Status */
    red:             #c1543f;
    green:           #8fbf6f;

    /* Borders */
    border:          #93a08c59;
    border-strong:   #d4a24aaa;

    /* Selection */
    selected-bg:       #d4a24a23;
    selected-bg-solid: #33341dff;
    selected-bg-2:     #a97ca019;
    selected-border:   #d4a24aaa;

    /* Transparent */
    transparent:     #00000000;
}
