@import "colors.rasi"

configuration {
    modi: "drun";

    show-icons: true;

    icon-theme: "Qogir-Dark";

    drun-display-format: "{name}";

    font: "JetBrainsMono Nerd Font 16";

    matching: "fuzzy";

    sort: true;

    sorting-method: "fzf";
}

* {
    font: "JetBrainsMono Nerd Font 16";

    background-color: @transparent;

    text-color: @fg;

    border-color: @border;
}

window {
    location: north;
    anchor: north;
    y-offset: 130px;

    width: 640px;

    background-color: @bg;

    border: 0px;

    border-radius: 20px;
}

mainbox {
    children: [
        inputbar,
        listview
    ];

    spacing: 0px;

    padding: 6px;
}

inputbar {
    children: [
        entry
    ];

    background-color: transparent;

    padding: 20px 24px;
}

entry {
    text-color: @fg;

    placeholder: "Sök...";

    placeholder-color: @fg-muted;

    font: "JetBrainsMono Nerd Font 18";
}

listview {
    columns: 1;

    lines: 7;

    spacing: 2px;

    scrollbar: false;

    padding: 4px 10px 14px 10px;

    dynamic: true;

    background-color: transparent;
}

element {
    orientation: horizontal;

    padding: 10px 14px;

    border-radius: 10px;
}

element-icon {
    size: 28px;

    margin: 0px 14px 0px 0px;
}

element-text {
    text-color: @fg;

    vertical-align: 0.5;
}

element normal.normal {
    background-color: @bg-solid;
    text-color: @fg;
}

element alternate.normal {
    background-color: @bg-solid;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg-solid;
    text-color: @cyan;
}
